<UserControl
    x:Class="Vocument.Windows.Views.WorkbenchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#F8F9FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Workbench Action Ribbon -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="OpenDocumentButton" Content="Open document..." Click="OnOpenDocumentClicked"/>
                <Button x:Name="RefreshThumbnailsButton" Content="Refresh thumbnails" Click="OnRefreshThumbnailsClicked"/>
                <AppBarSeparator/>
                <Button x:Name="RotateSelectedLeftButton" Content="Rotate left" Click="OnRotateSelectedLeftClicked"/>
                <Button x:Name="RotateSelectedRightButton" Content="Rotate right" Click="OnRotateSelectedRightClicked"/>
                <AppBarSeparator/>
                <Button x:Name="MovePagesButton" Content="Move pages" Click="OnMovePagesClicked"/>
                <Button x:Name="ExtractPagesButton" Content="Extract pages" Click="OnExtractPagesClicked"/>
                <Button x:Name="DeletePagesButton" Content="Delete pages" Click="OnDeletePagesClicked"/>
                <Button x:Name="StampPagesButton" Content="Stamp pages" Click="OnStampClicked"/>
                <AppBarSeparator/>
                <Button x:Name="UndoButton" Content="Undo" Click="OnUndoClicked"/>
                <Button x:Name="RedoButton" Content="Redo" Click="OnRedoClicked"/>
            </StackPanel>
        </Border>

        <!-- Grid of Thumbnail Tiles -->
        <ListView Grid.Row="1" x:Name="PageThumbnailsList" SelectionMode="Multiple" SelectionChanged="OnPageSelectionChanged" Padding="16" Margin="16">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6" ItemWidth="160" ItemHeight="220"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="150">
                        <Image Source="{Binding Thumbnail}" Stretch="None" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="#374151"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock x:Name="WorkbenchStatusText" Text="No document open" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
