<Window
    x:Class="Vocument.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Vocument.Windows.Views"
    mc:Ignorable="d"
    Title="Vocument">

    <Grid Background="#F5F5F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand & Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Vocument" FontSize="18" FontWeight="SemiBold" Foreground="#111827"/>
                    <TextBlock Text="Windows 11" FontSize="12" Foreground="#6B7280" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </StackPanel>

                <!-- Navigation Segments -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                    <RadioButton x:Name="ViewerTabRadio" Content="PDF Viewer" IsChecked="True" GroupName="NavTabs" Style="{StaticResource DefaultToggleButtonStyle}"/>
                    <RadioButton x:Name="WorkbenchTabRadio" Content="Page Workbench" GroupName="NavTabs" Style="{StaticResource DefaultToggleButtonStyle}"/>
                    <RadioButton x:Name="EditorTabRadio" Content="Flow Editor" GroupName="NavTabs" Style="{StaticResource DefaultToggleButtonStyle}"/>
                    <RadioButton x:Name="CompareTabRadio" Content="Document Compare" GroupName="NavTabs" Style="{StaticResource DefaultToggleButtonStyle}"/>
                </StackPanel>

                <!-- System / Settings Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Offline-First" FontSize="12" Foreground="#059669"/>
                    <Button x:Name="SettingsButton" Content="⚙ Settings" Click="OnSettingsClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Active View Host Container -->
        <Grid Grid.Row="1" x:Name="MainContentHost"/>
    </Grid>
</Window>
